# Copy to .env, replace both placeholders with long unique secrets. Never commit actual values.
CLIPRA_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
ALLOWED_ORIGINS=http://localhost:3000
CLIPRA_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
CLIPRA_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SESSION_KEY
COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://clipra:clipra@db:5432/clipra
MEDIA_ROOT=/data/media
MAX_UPLOAD_BYTES=10737418240
# Disabled by default to avoid leaking media or incurring charges.
ALLOW_EXTERNAL_AI=false
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.5-flash
MAX_AI_WINDOWS=4
AGGREGATOR_PROVIDER=
AGGREGATOR_API_KEY=
YOUTUBE_API_KEY=